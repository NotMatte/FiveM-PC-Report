<Project>
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Authors>NotMatte</Authors>
    <Product>FiveM PC Report</Product>
    <Copyright>Copyright (c) 2026 NotMatte</Copyright>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
